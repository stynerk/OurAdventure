{
  "name": "our-adventure",
  "private": true,
  "type": "module",
  "scripts": {
    "extract-course": "node scripts/extract-course.mjs",
    "test": "node --test tests/course.test.mjs tests/session.test.mjs tests/group-contract.test.mjs",
    "test:integration": "firebase emulators:exec --project demo-our-adventure --only firestore 'node --test tests/integration.test.mjs tests/group-model.integration.test.mjs'",
    "serve": "python3 -m http.server 8080",
    "test:browser": "ENABLE_INDIVIDUAL_PILOT=true firebase emulators:exec --project demo-our-adventure --only auth,firestore,functions 'node tests/browser.mjs'",
    "test:client": "firebase emulators:exec --project demo-our-adventure --only auth,firestore,functions 'node tests/client.mjs'",
    "test:callable-http": "firebase emulators:exec --project demo-our-adventure --only auth,firestore 'node tests/callable-http.mjs'",
    "test:callable-client": "firebase emulators:exec --project demo-our-adventure --only auth,firestore 'node tests/callable-http.mjs --client-only'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "express": "5.1.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "^15.34.0",
    "playwright": "^1.62.1"
  }
}
