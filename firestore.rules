rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(roomId) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }
    function member(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function groupMember(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    match /groups/{groupId} {
      allow get: if groupMember(groupId);
      // Clients query memberIds array-contains their own uid.
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
      match /members/{uid} {
        allow read: if groupMember(groupId);
        allow write: if false;
      }
      match /trips/{tripId} {
        allow read: if groupMember(groupId);
        allow write: if false;
        match /places/{placeId} {
          allow read: if groupMember(groupId);
          allow write: if false;
        }
        match /completions/{completionId} {
          allow read: if groupMember(groupId);
          allow write: if false;
        }
        match /posts/{postId} {
          allow read: if groupMember(groupId) && resource.data.status == 'published';
          allow write: if false;
        }
      }
    }
    match /rooms/{roomId} {
      // Enables the owner's `where(ownerId == uid)` query; participants get known rooms only.
      allow get: if member(roomId);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
      match /members/{uid} {
        allow get: if owner(roomId) || (member(roomId) && request.auth.uid == uid);
        allow list: if owner(roomId);
        allow write: if false;
      }
      match /activity/{eventId} {
        allow read: if owner(roomId);
        allow write: if false;
      }
    }
    // Invite hashes and everything else are server-only, including reads.
    match /{document=**} { allow read, write: if false; }
  }
}
